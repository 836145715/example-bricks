{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "id": "com.brickly.dotnet-lab",
  "version": "0.1.0",
  "apiVersion": "0.1.0",
  "name": {
    "zh-CN": ".NET 入门实验",
    "en": ".NET Starter Lab"
  },
  "description": {
    "zh-CN": ".NET 8 原生 Brick 示例：invoke、interact 流式事件、会话内 request 与资源读写。",
    "en": "Native .NET 8 Brick demo: invoke, interact streaming, in-session requests and resources."
  },
  "keywords": [
    "dotnet",
    "native",
    "demo",
    "interact",
    "resource"
  ],
  "author": "Brickly Demo",
  "runtime": {
    "type": "native",
    "instance": "owned",
    "platforms": [
      "win-x64",
      "win-arm64",
      "mac-x64",
      "mac-arm64",
      "linux-x64",
      "linux-arm64"
    ]
  },
  "commands": [
    {
      "id": "hello",
      "name": {
        "zh-CN": "问候",
        "en": "Hello"
      },
      "description": {
        "zh-CN": "返回问候语与 SDK 版本。"
      },
      "io": {
        "inputs": [
          {
            "name": "name",
            "label": "名字",
            "type": "string",
            "default": "Brickly"
          }
        ],
        "outputs": [
          {
            "name": "message",
            "type": "string"
          },
          {
            "name": "sdk",
            "type": "string"
          }
        ]
      }
    },
    {
      "id": "live",
      "mode": "interact",
      "name": {
        "zh-CN": "流式进度",
        "en": "Live progress"
      },
      "description": {
        "zh-CN": "推 4 条 progress 事件，并支持会话内 request 回显；调用方 end 后返回 done。"
      },
      "io": {
        "outputEvents": [
          {
            "name": "progress",
            "type": "number"
          }
        ],
        "outputs": [
          {
            "name": "done",
            "type": "boolean"
          }
        ]
      }
    },
    {
      "id": "make-resource",
      "name": {
        "zh-CN": "创建资源",
        "en": "Make resource"
      },
      "description": {
        "zh-CN": "把输入文本写成资源并返回 ResourceRef。"
      },
      "io": {
        "inputs": [
          {
            "name": "text",
            "label": "文本",
            "type": "string",
            "default": "hello resource"
          }
        ],
        "outputs": [
          {
            "name": "resource",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "read-resource",
      "name": {
        "zh-CN": "读取资源",
        "en": "Read resource"
      },
      "description": {
        "zh-CN": "接收 ResourceRef 并读取文本内容。"
      },
      "io": {
        "inputs": [
          {
            "name": "reference",
            "label": "ResourceRef",
            "type": "json",
            "required": true
          }
        ],
        "outputs": [
          {
            "name": "text",
            "type": "string"
          }
        ]
      }
    }
  ]
}
