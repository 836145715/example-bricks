{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "id": "com.brickly.clipboard-history",
  "version": "0.3.0",
  "apiVersion": ">=0.2.0 <1.0.0",
  "name": {
    "zh-CN": "剪贴板历史",
    "en": "Clipboard History"
  },
  "description": {
    "zh-CN": "单体剪贴板历史 Brick：订阅宿主剪贴板事件，持久化历史，并提供自定义界面与查询、删除、收藏能力。",
    "en": "Single clipboard history Brick with host clipboard event subscription, persistent storage, custom UI, and history management commands."
  },
  "icon": "assets/icon.svg",
  "keywords": [
    "clipboard",
    "history",
    "productivity",
    "local"
  ],
  "author": "Brickly Examples",
  "runtime": {
    "type": "node",
    "instance": "service",
    "entry": {
      "win-x64": "runtime/win-x64/index.cjs",
      "win-arm64": "runtime/win-arm64/index.cjs",
      "mac-x64": "runtime/mac-x64/index.cjs",
      "mac-arm64": "runtime/mac-arm64/index.cjs",
      "linux-x64": "runtime/linux-x64/index.cjs",
      "linux-arm64": "runtime/linux-arm64/index.cjs"
    },
    "autoStart": true
  },
  "subscriptions": [
    {
      "event": "clipboard:new-content",
      "from": "system"
    }
  ],
  "ui": {
    "type": "webview",
    "entry": "ui/index.html",
    "titleBar": "custom",
    "size": {
      "width": 820,
      "height": 560,
      "resizable": true
    }
  },
  "commands": [
    {
      "id": "list",
      "name": {
        "zh-CN": "列出历史",
        "en": "List History"
      },
      "description": "返回当前持久化的剪贴板历史记录数组。",
      "io": {
        "inputs": [
          {
            "name": "limit",
            "type": "number",
            "default": 500,
            "min": 1,
            "max": 2000
          }
        ],
        "outputs": [
          {
            "name": "items",
            "type": "json"
          }
        ]
      },
      "execution": "queue"
    },
    {
      "id": "remove",
      "name": {
        "zh-CN": "删除一条",
        "en": "Remove"
      },
      "description": "按 id 删除一条历史记录。",
      "io": {
        "inputs": [
          {
            "name": "id",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "ok",
            "type": "json"
          }
        ]
      },
      "execution": "queue"
    },
    {
      "id": "read-text",
      "name": {
        "zh-CN": "读取文本正文",
        "en": "Read Text"
      },
      "description": "按需读取一条文本历史的完整正文。",
      "io": {
        "inputs": [
          {
            "name": "id",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "text",
            "type": "string"
          }
        ]
      },
      "execution": "queue"
    },
    {
      "id": "clear",
      "name": {
        "zh-CN": "清空历史",
        "en": "Clear"
      },
      "description": "清空历史；keepFavorites=true 时保留收藏。",
      "io": {
        "inputs": [
          {
            "name": "keepFavorites",
            "type": "boolean",
            "default": false
          }
        ],
        "outputs": [
          {
            "name": "ok",
            "type": "json"
          }
        ]
      },
      "execution": "queue"
    },
    {
      "id": "toggle-favorite",
      "name": {
        "zh-CN": "切换收藏",
        "en": "Toggle Favorite"
      },
      "description": "切换某条记录的收藏状态。",
      "io": {
        "inputs": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "favorite",
            "type": "boolean",
            "description": "可选：直接指定目标收藏状态；缺省时按当前状态取反。"
          }
        ],
        "outputs": [
          {
            "name": "favorite",
            "type": "json"
          }
        ]
      },
      "execution": "queue"
    },
    {
      "id": "storage-info",
      "name": {
        "zh-CN": "存储信息",
        "en": "Storage Info"
      },
      "description": "返回数据目录、媒体目录、历史 JSON 路径、当前条数。",
      "io": {
        "outputs": [
          {
            "name": "info",
            "type": "json"
          }
        ]
      },
      "execution": "queue"
    },
    {
      "id": "sync-now",
      "name": {
        "zh-CN": "立即同步剪贴板",
        "en": "Sync Clipboard Now"
      },
      "description": "通过 Runtime clipboard API 读取当前剪贴板，并复用事件入库与去重流程。",
      "io": {
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "queue"
    },
    {
      "id": "set-content",
      "name": {
        "zh-CN": "写入剪贴板",
        "en": "Set Clipboard Content"
      },
      "description": "通过 Runtime clipboard API 将文本、图片或文件写回系统剪贴板。",
      "io": {
        "inputs": [
          {
            "name": "content",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "queue"
    },
    {
      "id": "runtime-status",
      "name": {
        "zh-CN": "Runtime 状态",
        "en": "Runtime Status"
      },
      "description": "返回剪贴板历史 Runtime 自身的监听、存储、去重和事件状态。",
      "io": {
        "outputs": [
          {
            "name": "status",
            "type": "json"
          }
        ]
      },
      "execution": "queue"
    }
  ]
}
