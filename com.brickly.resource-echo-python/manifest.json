{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "kind": "brick",
  "id": "com.brickly.resource-echo-python",
  "version": "0.2.0",
  "apiVersion": ">=0.2.0 <1.0.0",
  "name": {
    "zh-CN": "资源 Echo Python",
    "en": "Resource Echo Python"
  },
  "description": {
    "zh-CN": "Resource Lab 的 Python 跨进程资源校验端。",
    "en": "Python resource verifier for Resource Lab."
  },
  "author": {
    "name": "Brickly Examples"
  },
  "license": "MIT",
  "runtime": {
    "type": "python",
    "instance": "per-call",
    "platforms": [
      "win-x64",
      "win-arm64",
      "mac-x64",
      "mac-arm64",
      "linux-x64",
      "linux-arm64"
    ],
    "entry": {
      "win-x64": "runtime/win-x64/main.py",
      "win-arm64": "runtime/win-arm64/main.py",
      "mac-x64": "runtime/mac-x64/main.py",
      "mac-arm64": "runtime/mac-arm64/main.py",
      "linux-x64": "runtime/linux-x64/main.py",
      "linux-arm64": "runtime/linux-arm64/main.py"
    },
    "python": "3.12.*"
  },
  "lifecycle": {
    "state": "stateless"
  },
  "permissions": [],
  "subscriptions": [
    {
      "event": "resource-lab:probe",
      "from": "com.brickly.resource-lab"
    }
  ],
  "triggers": [
    {
      "type": "event",
      "event": "resource-lab:probe"
    }
  ],
  "dependencies": {
    "go_echo": {
      "target": {
        "brickId": "com.brickly.resource-echo-go",
        "origin": "installed",
        "version": "0.2.0"
      },
      "commands": [
        "inspect",
        "transform"
      ]
    },
    "node_echo": {
      "target": {
        "brickId": "com.brickly.resource-echo-node",
        "origin": "installed",
        "version": "0.2.0"
      },
      "commands": [
        "inspect",
        "transform"
      ]
    }
  },
  "trustLevel": "community",
  "ui": {
    "type": "none"
  },
  "categories": [
    "developer-tools"
  ],
  "keywords": [
    "resource",
    "test",
    "python"
  ],
  "commands": [
    {
      "id": "inspect",
      "name": "inspect",
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "produce",
      "name": "produce",
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "transform",
      "name": "transform",
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "relay",
      "name": "relay",
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "hold",
      "name": "hold",
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "event-last",
      "name": "event-last",
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    }
  ]
}
