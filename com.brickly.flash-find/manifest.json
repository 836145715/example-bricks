{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "id": "com.brickly.flash-find",
  "version": "0.1.0",
  "apiVersion": ">=0.2.0 <1.0.0",
  "name": {
    "zh-CN": "闪电搜索",
    "en": "Flash Find"
  },
  "description": {
    "zh-CN": "全盘文件即输即搜：内嵌 MacEverything C++ 引擎（getattrlistbulk 批量扫描 + trigram 倒排 + FSEvents 实时增量 + 磁盘缓存秒开），支持 ext:/size:/path:/regex: 等 Everything 风格过滤语法与 infile: 内容搜索。仅限 macOS。",
    "en": "Instant full-disk file search with the embedded MacEverything C++ engine (trigram index, FSEvents real-time updates, cached startup). Everything-style filters: ext: size: path: regex: infile:. macOS only."
  },
  "icon": "assets/icon.svg",
  "keywords": [
    "search",
    "files",
    "everything",
    "spotlight",
    "mdfind",
    "index",
    "fsevents",
    "macos"
  ],
  "author": "Brickly",
  "runtime": {
    "type": "native",
    "instance": "owned",
    "platforms": [
      "mac-arm64",
      "mac-x64"
    ],
    "entry": {
      "mac-arm64": "runtime/mac-arm64/brick",
      "mac-x64": "runtime/mac-x64/brick"
    }
  },
  "ui": {
    "type": "webview",
    "entry": "ui/index.html",
    "titleBar": "custom",
    "windowPolicy": "single",
    "size": {
      "width": 960,
      "height": 640,
      "minWidth": 720,
      "minHeight": 480,
      "resizable": true
    },
    "devTools": "debug-only"
  },
  "storage": {
    "quotaMB": 16
  },
  "commands": [
    {
      "id": "search",
      "name": {
        "zh-CN": "搜索文件",
        "en": "Search Files"
      },
      "description": {
        "zh-CN": "按文件名全盘搜索，输入即返回。透传 Everything 风格语法：空格分隔多个子串（AND）；ext:pdf size:>10mb path:下载 regex:foo\\d+ dm:today 等过滤器；infile:关键词 走内容索引。适合 LLM 按文件名/扩展名/路径定位文件。",
        "en": "Search files by name across the disk, instant results. Passes through Everything-style syntax: space-separated substrings (AND); filters ext:pdf size:>10mb path:Downloads regex:foo\\d+ dm:today; infile:term uses the content index. Best for locating files by name/ext/path."
      },
      "category": "搜索",
      "execution": "parallel",
      "io": {
        "inputs": [
          {
            "name": "query",
            "label": "查询",
            "type": "string",
            "required": true,
            "placeholder": "文件名关键词，可带过滤器",
            "description": "文件名子串或 Everything 风格过滤表达式。"
          },
          {
            "name": "limit",
            "label": "返回上限",
            "type": "number",
            "required": false,
            "default": 200,
            "min": 1,
            "max": 1000,
            "description": "最多返回条数。"
          },
          {
            "name": "scope",
            "label": "限定目录",
            "type": "string",
            "required": false,
            "description": "可选。路径前缀过滤，等价在 query 后追加 path: 过滤器。"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json",
            "description": "{items:[{name,path,type,size,mtime}],count,elapsedMs}"
          }
        ]
      }
    },
    {
      "id": "status",
      "name": {
        "zh-CN": "引擎状态",
        "en": "Engine Status"
      },
      "description": {
        "zh-CN": "读取索引引擎状态：记录数、是否扫描中/实时监控、扫描进度。调用其他命令前可用它判断索引是否就绪。",
        "en": "Read index engine status: record count, scanning/monitoring flags, scan progress. Call it first to check index readiness."
      },
      "category": "索引",
      "execution": "parallel",
      "io": {
        "inputs": [],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "reindex",
      "name": {
        "zh-CN": "重建索引",
        "en": "Rebuild Index"
      },
      "description": {
        "zh-CN": "丢弃缓存，触发全盘重新扫描。异步：受理后立即返回，进度轮询 status。",
        "en": "Drop cache and start a full-disk rescan. Async: returns immediately; poll status for progress."
      },
      "category": "索引",
      "io": {
        "inputs": [],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "recent",
      "name": {
        "zh-CN": "最近文件",
        "en": "Recent Files"
      },
      "description": {
        "zh-CN": "按修改时间倒序列出最近变动的文件。",
        "en": "List recently modified files, newest first."
      },
      "category": "搜索",
      "io": {
        "inputs": [
          {
            "name": "limit",
            "label": "条数",
            "type": "number",
            "required": false,
            "default": 50,
            "min": 1,
            "max": 500
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "quick-search",
      "hidden": true,
      "name": {
        "zh-CN": "快捷搜索",
        "en": "Quick Search"
      },
      "description": {
        "zh-CN": "宿主快捷搜索条的 files provider 后端：小 limit、快返回。",
        "en": "Backend for the host quick-search bar's files provider: small limit, fast return."
      },
      "io": {
        "inputs": [
          {
            "name": "query",
            "label": "查询",
            "type": "string",
            "required": true
          },
          {
            "name": "limit",
            "label": "条数",
            "type": "number",
            "required": false,
            "default": 8,
            "max": 8
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "quick-search-open",
      "hidden": true,
      "name": {
        "zh-CN": "打开快捷结果",
        "en": "Open Quick Result"
      },
      "description": {
        "zh-CN": "宿主激活快捷搜索结果时的回调（由宿主负责打开文件）。",
        "en": "Invoked by the host when a quick-search result is activated (the host opens the file)."
      },
      "io": {
        "inputs": [
          {
            "name": "path",
            "label": "路径",
            "type": "string",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      }
    }
  ],
  "quickSearch": {
    "providers": [
      {
        "id": "files",
        "title": {
          "zh-CN": "全盘文件",
          "en": "All Files"
        },
        "category": "file",
        "searchCommand": "quick-search",
        "activateCommand": "quick-search-open",
        "priority": 64,
        "timeoutMs": 900,
        "maxResults": 8,
        "minQueryLength": 1
      }
    ]
  }
}