{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "kind": "brick",
  "id": "com.brickly.screen-demo",
  "version": "0.2.0",
  "apiVersion": ">=0.1.0 <1.0.0",
  "name": {
    "zh-CN": "屏幕取色测试",
    "en": "Screen API Demo"
  },
  "description": {
    "zh-CN": "用于测试 ctx.platform.screen.pickColor 和 captureRegion 的最小示例 Brick。",
    "en": "Minimal demo brick for testing ctx.platform.screen.pickColor and captureRegion."
  },
  "keywords": [
    "screen",
    "screenshot",
    "color",
    "取色",
    "截图"
  ],
  "categories": [
    "developer-tools",
    "utilities"
  ],
  "author": {
    "name": "Brickly Demo",
    "publicKey": "ed25519:QUJDRA=="
  },
  "license": "MIT",
  "runtime": {
    "type": "node",
    "instance": "per-call",
    "platforms": [
      "win-x64",
      "win-arm64",
      "mac-x64",
      "mac-arm64",
      "linux-x64",
      "linux-arm64"
    ],
    "entry": {
      "win-x64": "runtime/win-x64/index.js",
      "win-arm64": "runtime/win-arm64/index.js",
      "mac-x64": "runtime/mac-x64/index.js",
      "mac-arm64": "runtime/mac-arm64/index.js",
      "linux-x64": "runtime/linux-x64/index.js",
      "linux-arm64": "runtime/linux-arm64/index.js"
    }
  },
  "lifecycle": {
    "state": "stateless"
  },
  "trustLevel": "community",
  "ui": {
    "type": "none"
  },
  "commands": [
    {
      "id": "pick-color",
      "name": {
        "zh-CN": "屏幕取色",
        "en": "Pick Screen Color"
      },
      "description": {
        "zh-CN": "打开宿主取色器，点击屏幕冻结帧中的一个像素并返回颜色。",
        "en": "Open the host color picker and return the selected pixel color."
      },
      "category": "screen",
      "io": {
        "inputs": [
          {
            "name": "timeoutMs",
            "label": "超时时间 (ms)",
            "type": "number",
            "default": 120000,
            "min": 1000,
            "max": 300000,
            "step": 1000
          }
        ],
        "outputs": [
          {
            "name": "color",
            "type": "json"
          }
        ]
      },
      "ui": {
        "submitLabel": "开始取色"
      }
    },
    {
      "id": "capture-region",
      "name": {
        "zh-CN": "区域截图 Data URL",
        "en": "Capture Region Data URL"
      },
      "description": {
        "zh-CN": "打开宿主框选截图，返回 PNG Data URL 的摘要信息。",
        "en": "Open the host region capture overlay and return a PNG Data URL summary."
      },
      "category": "screen",
      "io": {
        "inputs": [
          {
            "name": "timeoutMs",
            "label": "超时时间 (ms)",
            "type": "number",
            "default": 120000,
            "min": 1000,
            "max": 300000,
            "step": 1000
          }
        ],
        "outputs": [
          {
            "name": "capture",
            "type": "image"
          }
        ]
      },
      "ui": {
        "submitLabel": "开始截图"
      }
    }
  ]
}
