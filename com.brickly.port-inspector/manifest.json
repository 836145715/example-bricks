{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "kind": "brick",
  "id": "com.brickly.port-inspector",
  "version": "0.2.0",
  "apiVersion": ">=0.1.0 <1.0.0",
  "name": {
    "zh-CN": "端口占用查询",
    "en": "Port Inspector"
  },
  "description": {
    "zh-CN": "用系统 API 查询本机端口占用，展示进程信息，并在确认后结束进程。",
    "en": "Inspect local port ownership via system APIs, show process details, and terminate after confirmation."
  },
  "icon": "assets/icon.svg",
  "keywords": [
    "port",
    "process",
    "developer",
    "tcp",
    "udp",
    "netstat"
  ],
  "categories": [
    "developer-tools",
    "utilities"
  ],
  "author": {
    "name": "Brickly"
  },
  "license": "MIT",
  "runtime": {
    "type": "native",
    "platforms": [
      "win-x64",
      "win-arm64",
      "mac-x64",
      "mac-arm64"
    ],
    "entry": {
      "win-x64": "runtime/win-x64/brick.exe",
      "win-arm64": "runtime/win-arm64/brick.exe",
      "mac-x64": "runtime/mac-x64/brick",
      "mac-arm64": "runtime/mac-arm64/brick"
    }
  },
  "lifecycle": {
    "state": "stateless",
    "idleTimeoutMs": 0
  },
  "permissions": [
    "os.exec"
  ],
  "ui": {
    "type": "webview",
    "entry": "ui/index.html",
    "titleBar": "custom",
    "size": {
      "width": 1180,
      "height": 760,
      "minWidth": 720,
      "minHeight": 480,
      "resizable": true
    },
    "devTools": "debug-only",
    "theme": "dark"
  },
  "commands": [
    {
      "id": "lookup",
      "name": {
        "zh-CN": "查询端口占用",
        "en": "Lookup Port"
      },
      "description": {
        "zh-CN": "查询指定本机端口当前被哪些进程占用，返回协议、地址、PID 与进程名。",
        "en": "Find processes owning a local port; returns protocol, endpoints, PID and process name."
      },
      "category": "network",
      "io": {
        "inputs": [
          {
            "name": "port",
            "label": "端口号",
            "type": "number",
            "required": true,
            "min": 1,
            "max": 65535,
            "step": 1,
            "control": "input",
            "placeholder": "例如 3000"
          },
          {
            "name": "protocol",
            "label": "协议",
            "type": "string",
            "default": "all",
            "enum": [
              { "value": "all", "label": "全部" },
              { "value": "tcp", "label": "TCP" },
              { "value": "udp", "label": "UDP" }
            ]
          }
        ],
        "outputs": [
          { "name": "result", "type": "json" }
        ]
      },
      "examples": [
        {
          "title": "查询 3000 端口",
          "input": { "port": 3000, "protocol": "all" }
        }
      ],
      "llm": {
        "requireApproval": "never",
        "tags": ["port", "process", "readonly"]
      },
      "execution": "queue"
    },
    {
      "id": "list",
      "name": {
        "zh-CN": "列出端口占用",
        "en": "List Ports"
      },
      "description": {
        "zh-CN": "列出本机监听或已建立连接的端口占用，可按关键字过滤。",
        "en": "List local listening or established sockets with optional filter."
      },
      "category": "network",
      "io": {
        "inputs": [
          {
            "name": "query",
            "label": "过滤关键字",
            "type": "string",
            "default": "",
            "placeholder": "端口、PID 或进程名"
          },
          {
            "name": "protocol",
            "label": "协议",
            "type": "string",
            "default": "all",
            "enum": [
              { "value": "all", "label": "全部" },
              { "value": "tcp", "label": "TCP" },
              { "value": "udp", "label": "UDP" }
            ]
          },
          {
            "name": "includeEstablished",
            "label": "包含已建立连接",
            "type": "boolean",
            "default": true
          },
          {
            "name": "limit",
            "label": "最大返回数量",
            "type": "number",
            "default": 300,
            "min": 1,
            "max": 2000,
            "step": 1,
            "control": "input"
          }
        ],
        "outputs": [
          { "name": "result", "type": "json" }
        ]
      },
      "llm": {
        "requireApproval": "never",
        "tags": ["port", "process", "readonly"]
      },
      "execution": "queue"
    },
    {
      "id": "details",
      "name": {
        "zh-CN": "查看进程详情",
        "en": "Inspect Process Details"
      },
      "description": {
        "zh-CN": "按 PID 查看进程详情。",
        "en": "Inspect process details by PID."
      },
      "category": "process",
      "io": {
        "inputs": [
          {
            "name": "pid",
            "label": "PID",
            "type": "number",
            "required": true,
            "min": 1,
            "step": 1,
            "control": "input"
          }
        ],
        "outputs": [
          { "name": "result", "type": "json" }
        ]
      },
      "examples": [
        {
          "title": "查看指定进程详情",
          "input": { "pid": 12345 }
        }
      ],
      "llm": {
        "requireApproval": "never",
        "tags": ["process", "readonly"]
      },
      "execution": "queue"
    },
    {
      "id": "kill",
      "name": {
        "zh-CN": "结束进程",
        "en": "Kill Process"
      },
      "description": {
        "zh-CN": "按 PID 结束进程。必须在用户确认后调用。",
        "en": "Terminate a process by PID after explicit user confirmation."
      },
      "category": "process",
      "io": {
        "inputs": [
          {
            "name": "pid",
            "label": "PID",
            "type": "number",
            "required": true,
            "min": 1,
            "step": 1,
            "control": "input"
          },
          {
            "name": "force",
            "label": "强制结束",
            "type": "boolean",
            "default": false
          }
        ],
        "outputs": [
          { "name": "result", "type": "json" }
        ]
      },
      "examples": [
        {
          "title": "结束指定进程",
          "input": { "pid": 12345, "force": true }
        }
      ],
      "llm": {
        "requireApproval": "always",
        "tags": ["process", "dangerous"]
      },
      "execution": "queue"
    }
  ],
  "triggers": [
    { "type": "manual" }
  ]
}
