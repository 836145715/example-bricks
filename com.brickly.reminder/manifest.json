{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "id": "com.brickly.reminder",
  "version": "0.2.0",
  "apiVersion": ">=0.1.0 <1.0.0",
  "name": {
    "zh-CN": "提醒",
    "en": "Reminder"
  },
  "description": {
    "zh-CN": "按配置间隔在右上角弹出提醒。改完配置后点一次「立即提醒」即可生效。",
    "en": "Shows a quiet top-right reminder on an interval. Click Remind now after changing settings."
  },
  "keywords": [
    "reminder",
    "notification",
    "timer",
    "service"
  ],
  "author": "Brickly",
  "runtime": {
    "type": "node",
    "instance": "service",
    "entry": {
      "win-x64": "runtime/win-x64/index.js",
      "win-arm64": "runtime/win-arm64/index.js",
      "mac-x64": "runtime/mac-x64/index.js",
      "mac-arm64": "runtime/mac-arm64/index.js",
      "linux-x64": "runtime/linux-x64/index.js",
      "linux-arm64": "runtime/linux-arm64/index.js"
    },
    "autoStart": true
  },
  "config": {
    "required": true,
    "fields": [
      {
        "name": "enabled",
        "label": "启用提醒",
        "type": "boolean",
        "default": true
      },
      {
        "name": "intervalMinutes",
        "label": "提醒间隔(分钟)",
        "type": "number",
        "required": true,
        "default": 30,
        "min": 1,
        "max": 1440,
        "control": "input",
        "description": "每隔多少分钟提醒一次。"
      },
      {
        "name": "firstDelaySeconds",
        "label": "首次延迟(秒)",
        "type": "number",
        "default": 0,
        "min": 0,
        "max": 86400,
        "control": "input",
        "description": "服务启动后多久弹出第一次；0 表示等一个完整间隔。"
      },
      {
        "name": "title",
        "label": "标题",
        "type": "string",
        "default": "提醒"
      },
      {
        "name": "message",
        "label": "内容",
        "type": "string",
        "required": true,
        "multiline": true,
        "default": "该处理这件事了。"
      },
      {
        "name": "autoCloseSeconds",
        "label": "自动关闭秒数",
        "type": "number",
        "default": 12,
        "min": 0,
        "max": 120,
        "control": "input",
        "description": "0 表示不自动关闭。"
      }
    ]
  },
  "commands": [
    {
      "id": "preview",
      "window": "standalone",
      "name": {
        "zh-CN": "立即提醒",
        "en": "Remind now"
      },
      "description": {
        "zh-CN": "马上弹出一次提醒，并按当前配置重新开始计时。日常提醒由后台服务自动弹出，不用反复点这条。",
        "en": "Show the reminder now and restart the interval from the current Profile."
      },
      "io": {
        "inputs": [],
        "outputs": [
          {
            "name": "window",
            "type": "json"
          }
        ]
      },
      "ui": {
        "submitLabel": "提醒一次"
      },
      "execution": "queue"
    }
  ]
}
