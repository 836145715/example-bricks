{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "kind": "brick",
  "id": "com.brickly.ssh-manager",
  "version": "0.4.0",
  "apiVersion": ">=0.2.0 <1.0.0",
  "name": {
    "zh-CN": "SSH",
    "en": "SSH"
  },
  "description": {
    "zh-CN": "SSH 客户端：交互终端、远程命令，以及当前会话上的 SFTP 列目录、上传和下载。",
    "en": "SSH client with an interactive terminal, remote exec, and session-scoped SFTP list, upload, and download."
  },
  "icon": "assets/icon.svg",
  "keywords": [
    "ssh",
    "terminal",
    "remote",
    "ops",
    "server"
  ],
  "categories": [
    "developer-tools",
    "utilities"
  ],
  "author": {
    "name": "Brickly Examples"
  },
  "license": "MIT",
  "preload": "preload.cjs",
  "runtime": {
    "type": "native",
    "instance": "owned",
    "platforms": [
      "win-x64",
      "mac-arm64"
    ],
    "entry": {
      "win-x64": "runtime/win-x64/brick.exe",
      "mac-arm64": "runtime/mac-arm64/brick"
    }
  },
  "lifecycle": {
    "state": "stateful"
  },
  "permissions": [
    "fs.read",
    "fs.write",
    "net.tcp",
    "os.clipboard"
  ],
  "ui": {
    "type": "webview",
    "entry": "ui/index.html",
    "titleBar": "custom",
    "windowPolicy": "single",
    "size": {
      "width": 1180,
      "height": 760,
      "minWidth": 880,
      "minHeight": 560,
      "resizable": true
    },
    "devTools": "debug-only",
    "theme": "dark"
  },
  "commands": [
    {
      "id": "list-hosts",
      "name": {
        "zh-CN": "列出主机",
        "en": "List Hosts"
      },
      "description": "返回本机保存的 SSH 主机清单（不含密码、私钥），可按名称、地址、分组或标签过滤。",
      "category": "hosts",
      "execution": "parallel",
      "io": {
        "inputs": [
          {
            "name": "query",
            "label": "搜索",
            "type": "string",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "hosts",
            "type": "json",
            "description": "主机数组。"
          }
        ]
      }
    },
    {
      "id": "save-host",
      "name": {
        "zh-CN": "保存主机",
        "en": "Save Host"
      },
      "description": "新增或更新一台 SSH 主机。未提供 id 时自动生成。更新时密码/私钥留空则保持原值。",
      "category": "hosts",
      "io": {
        "inputs": [
          {
            "name": "host",
            "label": "主机",
            "type": "json",
            "required": true,
            "description": "SSH 主机对象：name、host、port、user、authType、password 或 keyPath/keyText、可选 passphrase、group、tags、note。"
          }
        ],
        "outputs": [
          {
            "name": "host",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "delete-host",
      "name": {
        "zh-CN": "删除主机",
        "en": "Delete Host"
      },
      "description": "按 id 删除已保存的 SSH 主机。",
      "category": "hosts",
      "io": {
        "inputs": [
          {
            "name": "hostId",
            "label": "主机 ID",
            "type": "string",
            "required": true
          }
        ],
        "outputs": [
          {
            "name": "ok",
            "type": "boolean"
          }
        ]
      }
    },
    {
      "id": "test-connection",
      "name": {
        "zh-CN": "测试连接",
        "en": "Test Connection"
      },
      "description": "测试 SSH 登录是否成功。可传已保存 hostId，或直接传未保存的主机对象。",
      "category": "hosts",
      "execution": "parallel",
      "timeoutMs": 15000,
      "io": {
        "inputs": [
          {
            "name": "hostId",
            "label": "主机 ID",
            "type": "string",
            "required": false
          },
          {
            "name": "host",
            "label": "主机配置",
            "type": "json",
            "required": false,
            "description": "未保存的主机对象；与 hostId 二选一。"
          }
        ],
        "outputs": [
          {
            "name": "ok",
            "type": "boolean"
          },
          {
            "name": "message",
            "type": "string"
          },
          {
            "name": "latencyMs",
            "type": "number"
          }
        ]
      }
    },
    {
      "id": "exec",
      "name": {
        "zh-CN": "执行远程命令",
        "en": "Exec Command"
      },
      "description": "在指定 Linux 主机上执行一条命令，返回 stdout、stderr 和 exitCode。适合 Agent 或工作流一次性调用。",
      "category": "remote",
      "execution": "parallel",
      "timeoutMs": 120000,
      "io": {
        "inputs": [
          {
            "name": "hostId",
            "label": "主机 ID",
            "type": "string",
            "required": false
          },
          {
            "name": "host",
            "label": "主机配置",
            "type": "json",
            "required": false
          },
          {
            "name": "command",
            "label": "命令",
            "type": "string",
            "required": true
          },
          {
            "name": "timeoutMs",
            "label": "超时毫秒",
            "type": "number",
            "required": false,
            "description": "默认 30000，最大 120000。"
          }
        ],
        "outputs": [
          {
            "name": "stdout",
            "type": "string"
          },
          {
            "name": "stderr",
            "type": "string"
          },
          {
            "name": "exitCode",
            "type": "number"
          }
        ]
      }
    },
    {
      "id": "open-session",
      "name": {
        "zh-CN": "打开终端会话",
        "en": "Open Session"
      },
      "description": "打开双工 SSH PTY 会话。调用方 send data/resize/cwd，Runtime 推 session/data/cwd/status；cancel 关闭会话。",
      "category": "terminal",
      "mode": "interact",
      "execution": "parallel",
      "timeoutMs": 86400000,
      "io": {
        "inputs": [
          {
            "name": "hostId",
            "label": "主机 ID",
            "type": "string",
            "required": true
          },
          {
            "name": "sessionId",
            "label": "会话 ID",
            "type": "string",
            "required": false,
            "description": "由前端生成；不传则由 runtime 生成。"
          },
          {
            "name": "cols",
            "label": "列数",
            "type": "number",
            "required": false
          },
          {
            "name": "rows",
            "label": "行数",
            "type": "number",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "sessionId",
            "type": "string"
          },
          {
            "name": "exitCode",
            "type": "number"
          }
        ],
        "outputEvents": [
          {
            "name": "session",
            "type": "json",
            "description": "会话建立后立即输出，包含 sessionId、hostId、status。"
          },
          {
            "name": "data",
            "type": "json",
            "description": "流式 PTY 数据，encoding=base64。"
          },
          {
            "name": "cwd",
            "type": "json",
            "description": "终端当前目录，来自 OSC 7 或 /proc 兜底。"
          },
          {
            "name": "status",
            "type": "json",
            "description": "会话结束状态。"
          }
        ],
        "inputEvents": [
          {
            "name": "data",
            "type": "json",
            "description": "PTY 字节：encoding + bytes"
          },
          {
            "name": "resize",
            "type": "json",
            "description": "cols / rows"
          },
          {
            "name": "cwd",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "sftp-list",
      "name": {
        "zh-CN": "列出远端目录",
        "en": "SFTP List"
      },
      "description": "列出远端目录。path 为空时返回家目录。传入 sessionId 时必须对应已打开的终端会话。",
      "category": "sftp",
      "execution": "parallel",
      "timeoutMs": 30000,
      "io": {
        "inputs": [
          {
            "name": "hostId",
            "label": "主机 ID",
            "type": "string",
            "required": true
          },
          {
            "name": "sessionId",
            "label": "会话 ID",
            "type": "string",
            "required": false,
            "description": "已打开的终端会话；传入后必须仍存活，否则失败。"
          },
          {
            "name": "path",
            "label": "远端目录",
            "type": "string",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "path",
            "type": "string"
          },
          {
            "name": "entries",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "sftp-upload",
      "name": {
        "zh-CN": "上传到远端",
        "en": "SFTP Upload"
      },
      "description": "把本机文件或目录上传到远端目录，并通过 interact 事件报告进度。",
      "category": "sftp",
      "mode": "call",
      "execution": "parallel",
      "timeoutMs": 3600000,
      "io": {
        "inputs": [
          {
            "name": "hostId",
            "type": "string",
            "required": true
          },
          {
            "name": "sessionId",
            "type": "string",
            "required": false,
            "description": "已打开的终端会话；传入后必须仍存活。"
          },
          {
            "name": "localPath",
            "type": "string",
            "required": true
          },
          {
            "name": "remoteDir",
            "type": "string",
            "required": false
          },
          {
            "name": "overwrite",
            "type": "boolean",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ],
        "outputEvents": [
          {
            "name": "progress",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "sftp-download",
      "name": {
        "zh-CN": "从远端下载",
        "en": "SFTP Download"
      },
      "description": "把远端文件或目录下载到本机目录，并通过 interact 事件报告进度。",
      "category": "sftp",
      "mode": "call",
      "execution": "parallel",
      "timeoutMs": 3600000,
      "io": {
        "inputs": [
          {
            "name": "hostId",
            "type": "string",
            "required": true
          },
          {
            "name": "sessionId",
            "type": "string",
            "required": false,
            "description": "已打开的终端会话；传入后必须仍存活。"
          },
          {
            "name": "remotePath",
            "type": "string",
            "required": true
          },
          {
            "name": "localDir",
            "type": "string",
            "required": true
          },
          {
            "name": "overwrite",
            "type": "boolean",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ],
        "outputEvents": [
          {
            "name": "progress",
            "type": "json"
          }
        ]
      }
    }
  ]
}
