{
  "manifestVersion": 1,
  "kind": "brick",
  "id": "com.brickly.starter-node-react",
  "version": "0.1.0",
  "apiVersion": ">=0.1.0 <1.0.0",
  "name": "Starter Node React",
  "description": "Starter Node React generated by Brickly Tool Starter.",
  "icon": "assets/icon.svg",
  "author": "Brickly",
  "ui": {
    "type": "webview",
    "entry": "ui/index.html",
    "size": {
      "width": 960,
      "height": 720,
      "resizable": true
    },
    "devTools": "debug-only"
  },
  "keywords": [],
  "$schema": "../specs/manifest.schema.json",
  "runtime": {
    "type": "node",
    "instance": "shared",
    "platforms": [
      "win-x64",
      "win-arm64",
      "mac-x64",
      "mac-arm64",
      "linux-x64",
      "linux-arm64"
    ],
    "entry": {
      "win-x64": "runtime/win-x64/index.js",
      "win-arm64": "runtime/win-arm64/index.js",
      "mac-x64": "runtime/mac-x64/index.js",
      "mac-arm64": "runtime/mac-arm64/index.js",
      "linux-x64": "runtime/linux-x64/index.js",
      "linux-arm64": "runtime/linux-arm64/index.js"
    }
  },
  "commands": [
    {
      "id": "hello",
      "name": "Hello World",
      "description": "返回一段最小可运行的问候结果。",
      "category": "example",
      "io": {
        "inputs": [
          {
            "name": "name",
            "label": "名称",
            "type": "string",
            "required": false,
            "default": "Brickly"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "ui": {
        "submitLabel": "运行 Hello"
      },
      "examples": [
        {
          "title": "Hello",
          "input": {
            "name": "Brickly"
          }
        }
      ]
    },
    {
      "id": "analyze-text",
      "name": "文本分析",
      "description": "统计文本字符数、词数、行数，并返回常用转换结果。",
      "category": "text",
      "io": {
        "inputs": [
          {
            "name": "text",
            "label": "文本",
            "type": "string",
            "required": true,
            "multiline": true,
            "default": "Hello Brickly\nBuild something useful."
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "ui": {
        "submitLabel": "分析文本"
      },
      "examples": [
        {
          "title": "文本分析",
          "input": {
            "text": "Hello Brickly"
          }
        }
      ]
    },
    {
      "id": "transform-json",
      "name": "JSON 转换",
      "description": "解析 JSON，返回类型、键列表、格式化文本和紧凑文本。",
      "category": "data",
      "io": {
        "inputs": [
          {
            "name": "json",
            "label": "JSON",
            "type": "string",
            "required": true,
            "multiline": true,
            "default": "{\"name\":\"Brickly\",\"kind\":\"tool\"}"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "ui": {
        "submitLabel": "转换 JSON"
      },
      "examples": [
        {
          "title": "JSON 转换",
          "input": {
            "json": "{\"name\":\"Brickly\"}"
          }
        }
      ]
    },
    {
      "id": "stream-demo",
      "name": "流式输出示例",
      "description": "演示 progress、chunk、output、取消检查和最终 result。",
      "category": "task",
      "io": {
        "inputs": [
          {
            "name": "topic",
            "label": "主题",
            "type": "string",
            "required": true,
            "default": "Brickly SDK"
          }
        ],
        "outputEvents": [
          {
            "name": "progress",
            "type": "json"
          },
          {
            "name": "chunk",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "text",
            "type": "string",
            "format": "markdown"
          },
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "mode": "call",
      "ui": {
        "submitLabel": "运行流式示例"
      },
      "examples": [
        {
          "title": "流式输出",
          "input": {
            "topic": "Brickly SDK"
          }
        }
      ]
    },
    {
      "id": "generate-report",
      "name": "生成报告",
      "description": "汇总主题和要点，返回 Markdown 报告。",
      "category": "report",
      "io": {
        "inputs": [
          {
            "name": "title",
            "label": "标题",
            "type": "string",
            "required": true,
            "default": "工具报告"
          },
          {
            "name": "notes",
            "label": "要点",
            "type": "string",
            "required": true,
            "multiline": true,
            "default": "支持 SDK\n支持 UI\n支持调用其它工具"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "string",
            "format": "markdown"
          }
        ]
      },
      "ui": {
        "submitLabel": "生成报告"
      },
      "examples": [
        {
          "title": "生成报告",
          "input": {
            "title": "工具报告",
            "notes": "支持 SDK"
          }
        }
      ]
    }
  ]
}
