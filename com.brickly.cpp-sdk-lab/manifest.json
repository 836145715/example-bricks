{
  "manifestVersion": 1,
  "kind": "brick",
  "id": "com.brickly.cpp-sdk-lab",
  "version": "0.1.0",
  "apiVersion": ">=0.1.0 <1.0.0",
  "name": "C++ SDK Lab",
  "description": "C++ SDK Lab generated by create-brickly.",
  "icon": "assets/icon.svg",
  "author": "Brickly Developer",
  "ui": {
    "type": "webview",
    "entry": "ui/index.html",
    "size": {
      "width": 420,
      "height": 400,
      "resizable": true
    },
    "devTools": "debug-only"
  },
  "keywords": [],
  "storage": {
    "quotaMB": 50
  },
  "$schema": "../specs/manifest.schema.json",
  "runtime": {
    "type": "native",
    "instance": "owned",
    "platforms": [
      "win-x64",
      "win-arm64",
      "mac-x64",
      "mac-arm64",
      "linux-x64",
      "linux-arm64"
    ],
    "entry": {
      "win-x64": "runtime/win-x64/brick.exe",
      "win-arm64": "runtime/win-arm64/brick.exe",
      "mac-x64": "runtime/mac-x64/brick",
      "mac-arm64": "runtime/mac-arm64/brick",
      "linux-x64": "runtime/linux-x64/brick",
      "linux-arm64": "runtime/linux-arm64/brick"
    }
  },
  "commands": [
    {
      "id": "timer",
      "name": "打开",
      "description": "打开跟随 runtime 的倒计时窗。会话结束或 runtime 停了，窗就关。",
      "category": "window",
      "window": "attach",
      "mode": "interact",
      "io": {
        "inputs": [
          {
            "name": "seconds",
            "label": "秒",
            "type": "number",
            "required": false,
            "default": 60
          }
        ],
        "inputEvents": [
          {
            "name": "control",
            "type": "json"
          }
        ],
        "outputEvents": [
          {
            "name": "tick",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "remaining",
            "type": "number"
          }
        ]
      },
      "ui": {
        "submitLabel": "打开"
      },
      "examples": [
        {
          "title": "打开",
          "input": {
            "seconds": 60
          }
        }
      ]
    },
    {
      "id": "pin",
      "name": "打开常驻",
      "description": "打开常驻倒计时窗。窗不关，runtime 不关。",
      "category": "window",
      "window": "standalone",
      "mode": "interact",
      "io": {
        "inputs": [
          {
            "name": "seconds",
            "label": "秒",
            "type": "number",
            "required": false,
            "default": 60
          }
        ],
        "inputEvents": [
          {
            "name": "control",
            "type": "json"
          }
        ],
        "outputEvents": [
          {
            "name": "tick",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "remaining",
            "type": "number"
          }
        ]
      },
      "ui": {
        "submitLabel": "打开常驻"
      },
      "examples": [
        {
          "title": "打开常驻",
          "input": {
            "seconds": 60
          }
        }
      ]
    }
  ]
}
