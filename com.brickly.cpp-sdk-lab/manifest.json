{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "id": "com.brickly.cpp-sdk-lab",
  "version": "0.1.0",
  "apiVersion": ">=0.1.0 <1.0.0",
  "name": {
    "zh-CN": "C++ SDK 实验室",
    "en": "C++ SDK Lab"
  },
  "description": {
    "zh-CN": "用 C++ SDK（Go c-shared 绑定）编写的 native Brick：问候、运行时信息、创建资源、interact 回声。",
    "en": "Native Brick written with the C++ SDK (Go c-shared binding): hello, runtime info, resource create, and interact echo."
  },
  "keywords": [
    "cpp",
    "c++",
    "native",
    "sdk",
    "demo",
    "lab"
  ],
  "author": "Brickly Demo",
  "runtime": {
    "type": "native",
    "instance": "per-call",
    "entry": {
      "win-x64": "runtime/win-x64/brick.exe",
      "win-arm64": "runtime/win-arm64/brick.exe",
      "mac-x64": "runtime/mac-x64/brick",
      "mac-arm64": "runtime/mac-arm64/brick",
      "linux-x64": "runtime/linux-x64/brick",
      "linux-arm64": "runtime/linux-arm64/brick"
    }
  },
  "commands": [
    {
      "id": "hello",
      "name": {
        "zh-CN": "问候",
        "en": "Hello"
      },
      "description": {
        "zh-CN": "用 C++ Runtime 返回一句问候。",
        "en": "Return a greeting from the C++ runtime."
      },
      "category": "example",
      "io": {
        "inputs": [
          {
            "name": "name",
            "label": "名称",
            "type": "string",
            "required": false,
            "default": "Brickly"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "ui": {
        "submitLabel": "问候"
      },
      "examples": [
        {
          "title": "Hello",
          "input": {
            "name": "Brickly"
          }
        }
      ]
    },
    {
      "id": "runtime-info",
      "name": {
        "zh-CN": "运行时信息",
        "en": "Runtime Info"
      },
      "description": {
        "zh-CN": "返回 C++ SDK 版本、协议、是否 Windows、应用名与临时目录。",
        "en": "Return C++ SDK version, protocol, Windows flag, app name and temp path."
      },
      "category": "example",
      "io": {
        "inputs": [],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "make-note",
      "name": {
        "zh-CN": "创建笔记资源",
        "en": "Make Note Resource"
      },
      "description": {
        "zh-CN": "把一段文本建成 Host 资源并回读校验。",
        "en": "Create a host resource from text and read it back."
      },
      "category": "example",
      "io": {
        "inputs": [
          {
            "name": "text",
            "label": "文本",
            "type": "string",
            "required": false,
            "default": "hello from C++",
            "multiline": true
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "chat",
      "name": {
        "zh-CN": "交互回声",
        "en": "Interact Echo"
      },
      "description": {
        "zh-CN": "C++ interact：收到调用方事件后回一条 reply。",
        "en": "C++ interact session that echoes caller events."
      },
      "category": "example",
      "mode": "interact",
      "io": {
        "inputs": [
          {
            "name": "prompt",
            "label": "开场",
            "type": "string",
            "required": false
          }
        ],
        "inputEvents": [
          {
            "name": "text",
            "type": "json"
          }
        ],
        "outputEvents": [
          {
            "name": "hello",
            "type": "json"
          },
          {
            "name": "reply",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      }
    }
  ]
}
