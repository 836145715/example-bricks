          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "restart-verify",
      "name": {
        "zh-CN": "restart-verify",
        "en": "restart-verify"
      },
      "io": {
        "inputs": [
          {
            "name": "input",
