{
  "$schema": "../specs/manifest.schema.json",
  "manifestVersion": 1,
  "kind": "brick",
  "id": "com.brickly.resource-lab",
  "version": "0.2.0",
  "apiVersion": ">=0.2.0 <1.0.0",
  "name": {
    "zh-CN": "资源验收测试台",
    "en": "Resource Lab"
  },
  "description": {
    "zh-CN": "交互式验证资源创建、流式读写、跨语言转交、生命周期和大载荷场景。",
    "en": "Interactive workbench for resource creation, streaming, cross-language transfer, lifecycle, and large payload tests."
  },
  "author": {
    "name": "Brickly Examples"
  },
  "license": "MIT",
  "runtime": {
    "type": "node",
    "instance": "owned",
    "platforms": [
      "win-x64",
      "win-arm64",
      "mac-x64",
      "mac-arm64",
      "linux-x64",
      "linux-arm64"
    ],
    "entry": {
      "win-x64": "runtime/win-x64/index.cjs",
      "win-arm64": "runtime/win-arm64/index.cjs",
      "mac-x64": "runtime/mac-x64/index.cjs",
      "mac-arm64": "runtime/mac-arm64/index.cjs",
      "linux-x64": "runtime/linux-x64/index.cjs",
      "linux-arm64": "runtime/linux-arm64/index.cjs"
    }
  },
  "lifecycle": {
    "state": "stateful",
    "service": {
      "autoStart": false,
      "restart": "none"
    }
  },
  "dependencies": {
    "node_echo": {
      "target": {
        "brickId": "com.brickly.resource-echo-node",
        "origin": "installed",
        "version": "0.2.0"
      },
      "commands": [
        "inspect",
        "produce",
        "transform",
        "relay",
        "hold",
        "cancel-hold",
        "event-last"
      ]
    },
    "python_echo": {
      "target": {
        "brickId": "com.brickly.resource-echo-python",
        "origin": "installed",
        "version": "0.2.0"
      },
      "commands": [
        "inspect",
        "produce",
        "transform",
        "relay",
        "hold",
        "event-last"
      ]
    },
    "go_echo": {
      "target": {
        "brickId": "com.brickly.resource-echo-go",
        "origin": "installed",
        "version": "0.2.0"
      },
      "commands": [
        "inspect",
        "produce",
        "transform",
        "relay",
        "hold",
        "event-last"
      ]
    }
  },
  "trustLevel": "community",
  "ui": {
    "type": "webview",
    "entry": "ui/index.html",
    "titleBar": "custom",
    "size": {
      "width": 1280,
      "height": 780,
      "minWidth": 900,
      "minHeight": 560,
      "resizable": true
    }
  },
  "categories": [
    "developer-tools",
    "utilities"
  ],
  "keywords": [
    "resource",
    "test",
    "stream",
    "runtime",
    "developer"
  ],
  "commands": [
    {
      "id": "suite-list",
      "name": {
        "zh-CN": "suite-list",
        "en": "suite-list"
      },
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "suite-run",
      "name": {
        "zh-CN": "suite-run",
        "en": "suite-run"
      },
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "suite-cancel",
      "name": {
        "zh-CN": "suite-cancel",
        "en": "suite-cancel"
      },
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "suite-status",
      "name": {
        "zh-CN": "suite-status",
        "en": "suite-status"
      },
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
