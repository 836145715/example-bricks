          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "suite-status",
      "name": {
        "zh-CN": "suite-status",
        "en": "suite-status"
      },
      "io": {
        "inputs": [
          {
            "name": "input",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "json"
          }
        ]
      },
      "execution": "parallel"
    },
    {
      "id": "suite-export",
      "name": {
        "zh-CN": "suite-export",
        "en": "suite-export"
      },
      "io": {
